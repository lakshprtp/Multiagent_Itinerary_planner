# AviationStack API Key for flight searches (https://aviationstack.com/)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Groq API Key for LLM inferences (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key for web search / hotel information (https://tavily.com/)
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL connection URL for conversation memory
DATABASE_URL=postgresql://user:password@localhost:5432/travel_planner

